{
  "name": "toolbelt-bridge",
  "version": "0.2.3",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env --allow-sys src/main.ts serve",
    "test": "deno test --allow-net --allow-run --allow-read --allow-write --allow-env --allow-sys tests/",
    "check": "deno check src/main.ts src/ui/app.js src/ui/registry-plan.js && deno lint && deno fmt --check",
    "compile": "deno run --allow-run --allow-read --allow-write --allow-env scripts/compile.ts",
    "compile:linux": "deno run --allow-run --allow-read --allow-write --allow-env scripts/compile.ts x86_64-unknown-linux-gnu",
    "compile:macos-x64": "deno run --allow-run --allow-read --allow-write --allow-env scripts/compile.ts x86_64-apple-darwin",
    "compile:macos-arm64": "deno run --allow-run --allow-read --allow-write --allow-env scripts/compile.ts aarch64-apple-darwin",
    "compile:windows": "deno run --allow-run --allow-read --allow-write --allow-env scripts/compile.ts x86_64-pc-windows-msvc"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.17",
    "@std/path": "jsr:@std/path@^1.0.9",
    "@std/assert": "jsr:@std/assert@^1.0.13"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "exclude": ["src/ui/app.js"]
  },
  "fmt": {
    "lineWidth": 90,
    "exclude": ["src/ui/vendor/"]
  }
}
